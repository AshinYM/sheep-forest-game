{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenAI Responses subset for forest interpreter",
    "version": "1.0.0",
    "description": "Local simulation subset based on official Responses and Structured Outputs documentation. Does not assert real model availability or classification quality."
  },
  "servers": [
    {
      "url": "https://api.openai.com"
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "operationId": "classifyForestAction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input",
                  "text",
                  "max_output_tokens",
                  "store"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "text": {
                    "type": "object"
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "maximum": 256
                  },
                  "store": {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed classification",
            "content": {
              "application/json": {
                "example": {
                  "id": "resp_simulation",
                  "object": "response",
                  "status": "completed",
                  "output": [
                    {
                      "id": "msg_simulation",
                      "type": "message",
                      "role": "assistant",
                      "status": "completed",
                      "content": [
                        {
                          "type": "output_text",
                          "text": "{\"kind\": \"action\", \"action\": \"stare\", \"target\": \"luminous\", \"item\": null}",
                          "annotations": []
                        }
                      ]
                    }
                  ],
                  "model": "simulation-model",
                  "created_at": 0,
                  "error": null,
                  "incomplete_details": null,
                  "usage": {
                    "input_tokens": 10,
                    "output_tokens": 20,
                    "total_tokens": 30,
                    "input_tokens_details": {
                      "cached_tokens": 0
                    },
                    "output_tokens_details": {
                      "reasoning_tokens": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "simulated provider error",
                    "type": "simulation"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "simulated provider error",
                    "type": "simulation"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Provider failure",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "simulated provider error",
                    "type": "simulation"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
