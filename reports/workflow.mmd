---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route_request(route_request)
	ended(ended)
	interpret_local(interpret_local)
	interpret_model(interpret_model)
	route_intent(route_intent)
	no_action(no_action)
	propose_action(propose_action)
	resolve_confirmation(resolve_confirmation)
	cancelled(cancelled)
	execute_rules(execute_rules)
	__end__([<p>__end__</p>]):::last
	__start__ --> route_request;
	interpret_local -.-> interpret_model;
	interpret_local -.-> route_intent;
	interpret_model --> route_intent;
	resolve_confirmation -.-> cancelled;
	resolve_confirmation -.-> execute_rules;
	route_intent -.-> execute_rules;
	route_intent -.-> no_action;
	route_intent -.-> propose_action;
	route_request -.-> ended;
	route_request -.-> interpret_local;
	route_request -.-> resolve_confirmation;
	cancelled --> __end__;
	ended --> __end__;
	execute_rules --> __end__;
	no_action --> __end__;
	propose_action --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

